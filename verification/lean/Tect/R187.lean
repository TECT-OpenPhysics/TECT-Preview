import Mathlib

namespace Tect.R187

theorem nonlinear_mean_fixture :
    (((1 : Rat) * (1 + (2 : Rat) / 5) + (-1) * (1 + 2 / 5)) / 2 = 0) /\
      (((1 : Rat) * (1 - (2 : Rat) / 5) + (-1) * (1 - 2 / 5)) / 2 = 0) := by
  norm_num

theorem nonlinear_square_deviation_fixture :
    ((1 + (2 : Rat) / 5) ^ 2 = 49 / 25) /\
      ((1 - (2 : Rat) / 5) ^ 2 = 9 / 25) /\
      (((49 : Rat) / 25 + 9 / 25) / 2 = 29 / 25) /\
      ((49 : Rat) / 25 - 29 / 25 = 4 / 5) /\
      ((9 : Rat) / 25 - 29 / 25 = -(4 / 5)) := by
  norm_num

theorem adapted_ledger_fixture :
    ((1 : Rat) / 2 - (1 / 20) / 4 = 39 / 80) /\
      ((1 : Rat) / 2 + (1 / 20) / 12 = 121 / 240) /\
      ((1 : Rat) - 39 / 80 - 121 / 240 = 1 / 120) /\
      ((6 : Rat) / ((1 : Rat) / 20) = 120) := by
  norm_num

theorem control_control_pair_slack_fixture :
    (((1 : Rat) / 20 - 1 - 2 * 0) / 6 = -(19 / 120)) /\
      (((1 : Rat) / 20 - 1 - 2 * (1 / 10)) / 6 = -(23 / 120)) /\
      (((1 : Rat) / 20 - 1 - 2 * (1 / 2)) / 6 = -(13 / 40)) := by
  norm_num

theorem finite_doob_fixture :
    ((((-1 : Rat) ^ 2 + ((-1) * (-1)) ^ 2) +
        ((-1 : Rat) ^ 2 + ((-1) * 1) ^ 2) +
        (1 ^ 2 + (1 * (-1)) ^ 2) +
        (1 ^ 2 + (1 * 1) ^ 2)) / 4 = 2) /\
      (((-1 : Rat) + (-1) * (-1)) ^ 2 +
        ((-1) + (-1) * 1) ^ 2 +
        (1 + 1 * (-1)) ^ 2 +
        (1 + 1 * 1) ^ 2) / 4 = 2 /\
      ((((-1 : Rat) + (-1) * (-1)) ^ 6 +
        ((-1) + (-1) * 1) ^ 6 +
        (1 + 1 * (-1)) ^ 6 +
        (1 + 1 * 1) ^ 6) / 4 = 32) /\
      ((((-1 : Rat) ^ 2 + ((-1) * (-1)) ^ 2) ^ 3 +
        ((-1 : Rat) ^ 2 + ((-1) * 1) ^ 2) ^ 3 +
        (1 ^ 2 + (1 * (-1)) ^ 2) ^ 3 +
        (1 ^ 2 + (1 * 1) ^ 2) ^ 3) / 4 = 8) /\
      ((32 : Rat) <= 8 * 8) := by
  norm_num

end Tect.R187
