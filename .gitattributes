# Append-only ledgers use canonical LF bytes on every platform.
*.jsonl text eol=lf
*.lean text eol=lf
*.toml text eol=lf
# Hash-pinned legacy compatibility copies preserve exact source bytes.
archive/legacy/references/** text eol=crlf
archive/legacy/notes/** text eol=crlf
archive/legacy/scripts/** text eol=crlf
archive/legacy/artefacts/** text eol=crlf
